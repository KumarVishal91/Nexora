PORT=4000

# SQLite for fast start. Switch to a Postgres URL later (see prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Redis (needed for Step 6 onward). Run redis locally or via docker:
# docker run -p 6379:6379 redis
REDIS_URL="redis://127.0.0.1:6379"

# Secret used to verify incoming webhook signatures (HMAC-SHA256)
WEBHOOK_SECRET="supersecret_change_me"
